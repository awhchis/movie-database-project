* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, sans-serif;
  }
  
  body {
    background: #0f1c32;
    color: #f5f5f5;
  }
  
  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    border-bottom: 1px solid #0f1c32;
    background: rgb(2, 3, 4);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  
  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .logo-link {
    display: flex;
    align-items: center;
  }
  
  .logo-image {
    height: 45px;   
    width: auto;
    cursor: pointer;
  }
  
  .home-btn {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid #444;
    background: transparent;
    color: #f5f5f5;
    cursor: pointer;
  }
  
  .home-btn:hover {
    background: #3f9897;
    color: #05060a;
  }
  
  /* Search */
  .search-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    max-width: 500px;
    margin: 0 2rem;
  }
  
  .search-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #444;
    background: #111;
    color: #f5f5f5;
  }
  
  .search-btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: none;
    background: #3f9897;
    color: #05060a;
    font-weight: 600;
    cursor: pointer;
  }
  
  /* Profile dropdown */
  .profile-dropdown {
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #444;
    background: #111;
    color: #f5f5f5;
  }
  
  /* Hero section */
  .hero {
    text-align: center;
    padding: 2.5rem 1rem 1.5rem;
  }
  
  .hero-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    letter-spacing: 0.25em;
  }
  
  .hero-main {
    font-size: 1.1rem;
  }
  
  .hero-sub {
    font-size: 0.9rem;
    color: #3f9897;
  }
  
  .hero h1 {
    font-size: 2.4rem;
    margin-top: 0.5rem;
  }
  

  .content-area {
    padding: 2rem;
    min-height: 400px;
  }
  .movie-entry-container {
    text-align: center;
    margin-top: 3rem;
  }
  
  .open-form-btn {
    padding: 3.2rem 3.0rem;
    background: #3f9897;
    color: #000000;
    border: none;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  
  .open-form-btn:hover {
    background: #82a9a8;
  }
  
  .movie-form {
    margin: 2rem auto;
    padding: 2rem;
    background: #111;
    border: 1px solid #333;
    border-radius: 1rem;
    width: 90%;
    max-width: 450px;
    text-align: left;
  }
  
  .movie-form h2 {
    text-align: center;
    margin-bottom: 1rem;
  }
  
  .movie-form label {
    display: block;
    margin-top: 1rem;
    margin-bottom: 0.3rem;
    font-weight: 600;
  }
  
  .movie-form input,
  .movie-form textarea {
    width: 100%;
    padding: 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid #444;
    background: #222;
    color: #fff;
  }
  
  .submit-btn {
    margin-top: 1.5rem;
    width: 100%;
    padding: 0.8rem;
    background: #3f9897;
    color: #05060a;
    border: none;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  
  .submit-btn:hover {
    background: #82a9a8;
  }  
  /* Scroll button */
  .scroll-top-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: #3f9897;
    color: #05060a;
    font-size: 1.2rem;
    cursor: pointer;
  }
